# ==============================================================================
# SolvAm (@solvam/web) — Environment Configuration Template
# ==============================================================================
# Copy this file to `apps/web/.env.local` for local development.
# NEVER commit real secrets to version control.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. CLERK AUTHENTICATION (https://dashboard.clerk.com)
# ------------------------------------------------------------------------------
# If left empty, SolvAm gracefully degrades to Anonymous Guest Mode (50 credits).
# Note: Must match formats `pk_test_...` / `pk_live_...` and `sk_test_...` / `sk_live_...`
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Optional Clerk Routing Overrides (if using custom Sign-In/Sign-Up pages)
# NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
# NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up

# ------------------------------------------------------------------------------
# 2. TURSO / libSQL DATABASE (https://turso.tech)
# ------------------------------------------------------------------------------
# If left empty, SolvAm defaults to a local SQLite file (`file:local.db`).
# For Vercel/Production or Cross-Device Mobile QR Sync, use a remote Turso URL:
# Format: libsql://your-db-name-your-org.turso.io
TURSO_DATABASE_URL="file:local.db"
TURSO_AUTH_TOKEN=

# ------------------------------------------------------------------------------
# 3. DETERMINISTIC SYMBOLIC ENGINE (Python FastAPI + SymPy)
# ------------------------------------------------------------------------------
# Server-side URL for Next.js API routes & tool calls
SYMBOLIC_ENGINE_URL="http://localhost:8000"
# Client-side URL for the UI health indicator
NEXT_PUBLIC_SYMBOLIC_ENGINE_URL="http://localhost:8000"

# ------------------------------------------------------------------------------
# 4. META AI MODEL ECOSYSTEM (Muse Spark 1.3 / SAM 3.1)
# ------------------------------------------------------------------------------
# If left empty, SolvAm runs its local Neuro-Symbolic SymPy fallback loop.
META_API_KEY=
META_API_URL="https://api.meta.ai/v1/chat/completions"
